{
  "name": "rexsun",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3700",
    "build": "prisma generate && prisma db push && node scripts/seed.mjs && next build",
    "start": "next start -p 3000",
    "catalog": "node scripts/build-catalog.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "reset": "node --env-file-if-exists=.env scripts/seed.mjs --reset",
    "db": "prisma studio",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.4",
    "postcss": "^8.5.27",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
